{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terrafar source check result",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "source_id",
    "outcome",
    "attempted",
    "completed_at",
    "scope",
    "target_validated",
    "content_complete",
    "baseline_available",
    "evidence",
    "reason",
    "candidate_count"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "checked_changed",
        "checked_unchanged",
        "checked_empty",
        "partial",
        "needs_endpoint",
        "failed",
        "blocked",
        "not_attempted"
      ]
    },
    "attempted": {
      "type": "boolean"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "target_validated": {
      "type": "boolean"
    },
    "content_complete": {
      "type": "boolean"
    },
    "baseline_available": {
      "type": "boolean"
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "first_observed": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "retrieved_at",
          "content_sha256",
          "locator",
          "excerpt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "maxLength": 800
          }
        },
        "additionalProperties": true
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "checked_changed",
              "checked_unchanged",
              "checked_empty"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "target_validated": {
            "const": true
          },
          "content_complete": {
            "const": true
          },
          "attempted": {
            "const": true
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "checked_unchanged"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "baseline_available": {
            "const": true
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
