{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TERRAFAR independent audit failure; never a human approval",
  "type": "object",
  "required": ["format", "batch_id", "revision", "content_digest", "actor_kind", "auditor", "reviewed_at", "report_path", "report_sha256", "error_record_ids", "evidence"],
  "properties": {
    "format": {"const": "terrafar-independent-audit-failure-v1"},
    "batch_id": {"type": "string", "pattern": "^terrafar-quality-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "revision": {"type": "integer", "minimum": 1},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor_kind": {"enum": ["agent", "automated_audit"]},
    "auditor": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "report_path": {"type": "string", "minLength": 1},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "error_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "source_invalidations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "source_result_digest", "reason", "evidence"],
        "properties": {
          "source_id": {"type": "string"},
          "source_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["url", "claim", "locator", "page_content_sha256"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "claim": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "page_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
