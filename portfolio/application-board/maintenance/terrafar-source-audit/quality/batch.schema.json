{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TERRAFAR daily quality batch",
  "type": "object",
  "required": ["format", "schema_version", "batch_id", "date", "timezone", "revision", "content_digest", "required_source_ids", "run_manifests", "source_checks", "records", "catalog_inventory", "sample", "human_review", "review_history", "recheck", "release_gate", "events"],
  "properties": {
    "format": {"const": "terrafar-quality-batch-v1"},
    "schema_version": {"const": 1},
    "batch_id": {"type": "string", "pattern": "^terrafar-quality-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "date": {"type": "string", "format": "date"},
    "timezone": {"const": "Asia/Shanghai"},
    "revision": {"type": "integer", "minimum": 1},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "run_manifests": {"type": "array", "items": {"type": "object"}},
    "source_checks": {"type": "array", "items": {"type": "object", "required": ["source_id", "run_id", "outcome", "network_mode", "observed_at", "result_digest"]}},
    "records": {"type": "array", "items": {"type": "object", "required": ["record_id", "source_id", "record_scope", "record_digest", "payload", "changes", "field_evidence"]}},
    "catalog_inventory": {"type": ["object", "null"]},
    "sample": {"type": "object", "required": ["seed", "record_ids", "random_record_ids", "high_risk_record_ids", "statistical_claim"]},
    "human_review": {"type": "object", "required": ["decision"], "properties": {"decision": {"enum": ["pending", "pass", "fail"]}}},
    "review_history": {"type": "array"},
    "recheck": {"type": "object", "required": ["required", "round", "required_record_ids", "completed"]},
    "release_gate": {"type": "object", "required": ["allowed", "blockers", "source_coverage", "record_blockers", "initial_catalog_blockers", "checked_content_digest"]},
    "events": {"type": "array"}
  }
}
